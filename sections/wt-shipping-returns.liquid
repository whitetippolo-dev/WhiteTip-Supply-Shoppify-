{% comment %}
  WhiteTip custom section — breadcrumb + heading + intro, then a sticky
  on-page table of contents (desktop) / pill row (mobile) generated from
  'topic' blocks, each becoming one <h2> + rich-text body in the article.
  Built as structured blocks rather than parsing page.content's HTML for
  headings, which would be fragile.
{% endcomment %}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width wt-sr-header">
    <nav class="wt-breadcrumb" aria-label="{{ 'general.breadcrumb.label' | t }}">
      <a href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ section.settings.heading | escape }}</span>
    </nav>
    <h1 class="wt-sr-heading">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.intro != blank -%}
      <p class="wt-sr-intro">{{ section.settings.intro }}</p>
    {%- endif -%}

    <nav class="wt-sr-toc-mobile" aria-label="On this page">
      {%- for block in section.blocks -%}
        {%- if block.type == 'topic' -%}
          <a href="#wt-topic-{{ forloop.index }}">{{ block.settings.heading | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  </div>

  <div class="page-width wt-sr-layout">
    <nav class="wt-sr-toc-desktop" aria-label="On this page">
      <span class="wt-sr-toc-desktop__label">On this page</span>
      {%- for block in section.blocks -%}
        {%- if block.type == 'topic' -%}
          <a href="#wt-topic-{{ forloop.index }}">{{ block.settings.heading | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <article class="wt-sr-article">
      {%- for block in section.blocks -%}
        {%- if block.type == 'topic' -%}
          <section id="wt-topic-{{ forloop.index }}" {{ block.shopify_attributes }}>
            <h2>{{ block.settings.heading | escape }}</h2>
            <div class="rte">{{ block.settings.content }}</div>
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link }}" class="button button--secondary">
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}
          </section>
        {%- endif -%}
      {%- endfor -%}
    </article>
  </div>
</div>

{% stylesheet %}
  .wt-sr-header {
    padding: 48px 0;
    border-bottom: 1px solid var(--wt-ocean-600);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .wt-sr-heading {
    margin: 0;
    font-size: var(--fs-web-h2);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .wt-sr-intro {
    margin: 0;
    max-width: 640px;
    font-size: var(--fs-web-body);
    line-height: 1.5;
    color: var(--wt-grey);
  }

  .wt-sr-toc-mobile {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .wt-sr-toc-mobile a {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--wt-ocean-600);
    font-size: var(--fs-web-label);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--wt-offwhite);
  }

  .wt-sr-layout {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding: 48px 0 88px;
  }

  .wt-sr-toc-desktop {
    display: none;
  }

  @media screen and (min-width: 990px) {
    .wt-sr-toc-mobile {
      display: none;
    }

    .wt-sr-layout {
      flex-direction: row;
      gap: 120px;
      padding: 64px 0 120px;
    }

    .wt-sr-toc-desktop {
      display: flex;
      flex-direction: column;
      gap: 8px;
      flex: none;
      width: 256px;
      position: sticky;
      top: 32px;
      align-self: flex-start;
    }

    .wt-sr-toc-desktop__label {
      font-size: var(--fs-web-label);
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--wt-grey);
      padding-bottom: 8px;
    }

    .wt-sr-toc-desktop a {
      display: flex;
      align-items: center;
      gap: 16px;
      min-height: 44px;
      font-size: var(--fs-web-small);
      font-weight: 600;
      color: var(--wt-grey);
    }

    .wt-sr-toc-desktop a:hover {
      color: var(--wt-teal-bright);
    }
  }

  .wt-sr-article {
    display: flex;
    flex-direction: column;
    gap: 64px;
    max-width: 720px;
  }

  .wt-sr-article h2 {
    margin: 0 0 24px;
    font-size: var(--fs-web-h3);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.12;
  }

  .wt-sr-article .rte {
    font-size: var(--fs-web-body);
    line-height: 1.5;
    color: var(--wt-grey);
  }

  .wt-sr-article .button {
    margin-top: 16px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shipping & returns",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Shipping & returns",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>How we ship, how pre-orders work, and how to return gear.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Topic",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Topic"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label (optional)"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shipping & returns",
      "blocks": [{ "type": "topic" }, { "type": "topic" }]
    }
  ]
}
{% endschema %}
