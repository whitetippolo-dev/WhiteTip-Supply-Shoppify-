{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact page-width{% if section.settings.details_heading == blank %} page-width--narrow{% else %} wt-contact--with-details{% endif %} section-{{ section.id }}-padding">
    {%- if section.settings.details_heading != blank -%}
      <div class="wt-contact-details">
        {%- if section.settings.details_eyebrow != blank -%}
          <div class="wt-section-eyebrow">{{ section.settings.details_eyebrow | escape }}</div>
        {%- endif -%}
        <h1 class="wt-contact-details__heading">{{ section.settings.details_heading }}</h1>
        <div class="wt-contact-details__rule"></div>
        {%- if section.settings.details_text != blank -%}
          <div class="wt-contact-details__text rte">{{ section.settings.details_text }}</div>
        {%- endif -%}
        {%- if section.settings.details_list != blank -%}
          <div class="wt-contact-details__list rte">{{ section.settings.details_list }}</div>
        {%- endif -%}
        {%- if section.settings.details_link_url != blank -%}
          <a href="{{ section.settings.details_link_url }}" class="wt-contact-details__card">
            <span>
              <strong>{{ section.settings.details_link_heading | escape }}</strong>
              <small>{{ section.settings.details_link_text | escape }}</small>
            </span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="wt-contact-form-col">
    {%- if section.settings.heading != blank -%}
      <h2 class="title title-wrapper--no-top-margin inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ section.settings.heading }}
      </h2>
    {%- elsif section.settings.details_heading == blank -%}
      <h2 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h2>
    {%- endif -%}
    {%- liquid
      assign contact_form_class = 'isolate'
      if settings.animations_reveal_on_scroll
        assign contact_form_class = 'isolate scroll-trigger animate--slide-in'
      endif
    -%}
    {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}
      {%- if form.posted_successfully? -%}
        <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
          {{- 'icon-success.svg' | inline_asset_content -}}
          {{ 'templates.contact.form.post_success' | t }}
        </h2>
      {%- elsif form.errors -%}
        <div class="form__message">
          <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
            {{- 'icon-error.svg' | inline_asset_content -}}
            {{ 'templates.contact.form.error_heading' | t }}
          </h2>
        </div>
        <ul class="form-status-list caption-large" role="list">
          <li>
            <a href="#ContactForm-email" class="link">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </a>
          </li>
        </ul>
      {%- endif -%}
      <div class="contact__fields">
        <div class="field">
          <input
            class="field__input"
            autocomplete="name"
            type="text"
            id="ContactForm-name"
            name="contact[{{ 'templates.contact.form.name' | t }}]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="{{ 'templates.contact.form.name' | t }}"
          >
          <label class="field__label" for="ContactForm-name">{{ 'templates.contact.form.name' | t }}</label>
        </div>
        <div class="field field--with-error">
          <input
            autocomplete="email"
            type="email"
            id="ContactForm-email"
            class="field__input"
            name="contact[email]"
            spellcheck="false"
            autocapitalize="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="ContactForm-email-error"
            {% endif %}
            placeholder="{{ 'templates.contact.form.email' | t }}"
          >
          <label class="field__label" for="ContactForm-email">
            {{- 'templates.contact.form.email' | t }}
            <span aria-hidden="true">*</span></label
          >
          {%- if form.errors contains 'email' -%}
            <small class="contact__field-error" id="ContactForm-email-error">
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              <span class="form__message">
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </span>
            </small>
          {%- endif -%}
        </div>
      </div>
      <div class="contact__fields">
        <div class="field">
          <input
            type="tel"
            id="ContactForm-phone"
            class="field__input"
            autocomplete="tel"
            name="contact[{{ 'templates.contact.form.phone' | t }}]"
            pattern="[0-9\-]*"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            placeholder="{{ 'templates.contact.form.phone' | t }}"
          >
          <label class="field__label" for="ContactForm-phone">{{ 'templates.contact.form.phone' | t }}</label>
        </div>

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'custom_text' -%}
              <div class="field" {{ block.shopify_attributes }}>
                <input
                  type="{{ block.settings.input_type }}"
                  id="ContactForm-{{ block.id }}"
                  class="field__input"
                  name="contact[{{ block.settings.label }}]"
                  placeholder="{{ block.settings.label }}{% if block.settings.optional %} (optional){% endif %}"
                  {% unless block.settings.optional %}
                    aria-required="true"
                  {% endunless %}
                >
                <label class="field__label" for="ContactForm-{{ block.id }}">
                  {{- block.settings.label -}}
                  {% if block.settings.optional %}<span class="wt-field-optional">optional</span>{% endif %}
                </label>
              </div>
            {%- when 'custom_select' -%}
              {%- assign wt_select_options = block.settings.options | newline_to_br | strip_newlines | split: '<br />' -%}
              <div class="field" {{ block.shopify_attributes }}>
                <select
                  id="ContactForm-{{ block.id }}"
                  class="field__input wt-select"
                  name="contact[{{ block.settings.label }}]"
                >
                  {%- for option in wt_select_options -%}
                    {%- if option != blank -%}
                      <option value="{{ option | strip | escape }}">{{ option | strip | escape }}</option>
                    {%- endif -%}
                  {%- endfor -%}
                </select>
                <label class="field__label wt-select-label" for="ContactForm-{{ block.id }}">
                  {{- block.settings.label -}}
                </label>
              </div>
            {%- when 'custom_checkboxes' -%}
              {%- assign wt_checkbox_options = block.settings.options | newline_to_br | strip_newlines | split: '<br />' -%}
              <fieldset class="field field--full wt-checkbox-group" {{ block.shopify_attributes }}>
                <legend class="field__label wt-checkbox-group__legend">{{ block.settings.label }}</legend>
                <div class="wt-checkbox-group__options">
                  {%- for option in wt_checkbox_options -%}
                    {%- if option != blank -%}
                      {%- assign option_clean = option | strip -%}
                      {%- assign option_id = 'ContactForm-' | append: block.id | append: '-' | append: forloop.index -%}
                      <input
                        type="checkbox"
                        id="{{ option_id }}"
                        class="wt-checkbox-group__input"
                        name="contact[{{ block.settings.label | escape }}][]"
                        value="{{ option_clean | escape }}"
                      >
                      <label for="{{ option_id }}" class="wt-checkbox-group__pill">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m5 12 5 5 9-10"></path></svg>
                        {{- option_clean | escape -}}
                      </label>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </fieldset>
          {%- endcase -%}
        {%- endfor -%}
      </div>
      <div class="field">
        <textarea
          rows="10"
          id="ContactForm-body"
          class="text-area field__input"
          name="contact[{{ 'templates.contact.form.comment' | t }}]"
          placeholder="{{ 'templates.contact.form.comment' | t }}"
        >
          {{- form.body -}}
        </textarea>
        <label class="form__label field__label" for="ContactForm-body">
          {{- 'templates.contact.form.comment' | t -}}
        </label>
      </div>
      <div class="contact__button">
        <button type="submit" class="button">
          {{ 'templates.contact.form.send' | t }}
        </button>
      </div>
    {%- endform -%}
    </div>
  </div>
</div>

{% stylesheet %}
  @media screen and (min-width: 990px) {
    .wt-contact--with-details {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 120px;
      max-width: none;
    }
  }

  .wt-contact-details__heading {
    margin: 0;
    font-size: var(--fs-web-h2);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .wt-contact-details__rule {
    width: 88px;
    height: 1px;
    background: var(--wt-teal);
    margin: 24px 0;
  }

  .wt-contact-details__text,
  .wt-contact-details__list {
    max-width: 440px;
    color: var(--wt-grey);
  }

  .wt-contact-details__list {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--wt-ocean-600);
  }

  .wt-contact-details__card {
    margin-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 24px;
    background: var(--wt-ocean-700);
    border: 1px solid var(--wt-ocean-600);
    color: var(--wt-offwhite);
  }

  .wt-contact-details__card:hover {
    background: var(--wt-ocean-600);
  }

  .wt-contact-details__card strong {
    display: block;
    font-size: var(--fs-web-label);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .wt-contact-details__card small {
    font-size: var(--fs-web-small);
    color: var(--wt-grey);
  }

  .wt-field-optional {
    margin-left: 8px;
    font-weight: 400;
    text-transform: none;
    letter-spacing: normal;
    color: var(--wt-grey);
  }

  .wt-select {
    appearance: none;
    -webkit-appearance: none;
  }

  .wt-select-label {
    pointer-events: none;
  }

  .field--full {
    grid-column: 1 / -1;
  }

  .wt-checkbox-group__legend {
    padding: 0;
    margin-bottom: 16px;
  }

  .wt-checkbox-group__options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .wt-checkbox-group__input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .wt-checkbox-group__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 20px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--wt-grey);
    color: var(--wt-offwhite);
    font-size: var(--btn-fs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .wt-checkbox-group__pill svg {
    display: none;
  }

  .wt-checkbox-group__input:checked + .wt-checkbox-group__pill {
    background: var(--wt-offwhite);
    border-color: var(--wt-offwhite);
    color: var(--wt-ocean);
  }

  .wt-checkbox-group__input:checked + .wt-checkbox-group__pill svg {
    display: block;
  }

  .wt-checkbox-group__input:focus-visible + .wt-checkbox-group__pill {
    outline: var(--focus-outline);
    outline-offset: var(--focus-offset);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "custom_text",
      "name": "Custom field — text",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "Label",
          "label": "Label"
        },
        {
          "type": "select",
          "id": "input_type",
          "default": "text",
          "label": "Input type",
          "options": [
            { "value": "text", "label": "Text" },
            { "value": "number", "label": "Number" },
            { "value": "email", "label": "Email" }
          ]
        },
        {
          "type": "checkbox",
          "id": "optional",
          "default": false,
          "label": "Optional"
        }
      ]
    },
    {
      "type": "custom_select",
      "name": "Custom field — dropdown",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "Label",
          "label": "Label"
        },
        {
          "type": "textarea",
          "id": "options",
          "default": "Option one\nOption two",
          "label": "Options",
          "info": "One option per line."
        }
      ]
    },
    {
      "type": "custom_checkboxes",
      "name": "Custom field — checkbox pills",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "Label",
          "label": "Label"
        },
        {
          "type": "textarea",
          "id": "options",
          "default": "Option one\nOption two",
          "label": "Options",
          "info": "One option per line."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Details column (optional — leave heading blank to hide)"
    },
    {
      "type": "text",
      "id": "details_eyebrow",
      "label": "Details eyebrow",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "details_heading",
      "label": "Details heading",
      "default": ""
    },
    {
      "type": "richtext",
      "id": "details_text",
      "label": "Details intro text"
    },
    {
      "type": "richtext",
      "id": "details_list",
      "label": "Details list",
      "info": "E.g. a short paragraph per line: Email, Based in, Fit sessions, Instagram."
    },
    {
      "type": "text",
      "id": "details_link_heading",
      "label": "Link card heading"
    },
    {
      "type": "text",
      "id": "details_link_text",
      "label": "Link card text"
    },
    {
      "type": "url",
      "id": "details_link_url",
      "label": "Link card URL"
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.contact-form.settings.title.default",
      "label": "t:sections.contact-form.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name"
    }
  ]
}
{% endschema %}
